# ============================================================
# ACARBOT V22 - RUNTIME CONFIG  (package/module name stays `phoenix`)
# Copy to .env. Read-only and paper modes need NO credentials.
# Never commit real secrets.
# ============================================================

# ---------------- EXCHANGE CREDENTIALS (only for --live) ----------------
# Comma-separated CCXT exchange ids. READ_ONLY/PAPER uses public endpoints only.
PHOENIX_EXCHANGES=binance,okx
PHOENIX_BINANCE_API_KEY=
PHOENIX_BINANCE_API_SECRET=
PHOENIX_OKX_API_KEY=
PHOENIX_OKX_API_SECRET=
PHOENIX_OKX_PASSPHRASE=

# Sandbox flags. 0 = public mainnet market data (READ_ONLY/PAPER default).
# Set 1 only for an order-flow test against testnet/demo keys (sandbox prices are demo quality).
PHOENIX_BINANCE_SANDBOX=0
PHOENIX_OKX_SANDBOX=0

# Binance public route: auto (default) = use normal host, switch to the www host only if HTTP 451
# is returned; 1 = always www; 0 = never. Spot is never loaded.
PHOENIX_BINANCE_PUBLIC_WWW=auto

# ---------------- MODE SAFETY ----------------
# Default mode is READ_ONLY. --paper => PAPER. --live => real orders and ONLY works with this:
PHOENIX_CONFIRM_LIVE=
PHOENIX_LIVE_TRADING=0
PHOENIX_PAPER_TRADING=0
PHOENIX_PAPER_EQUITY=1000

# ---------------- ACCOUNT / RISK ----------------
# USER RULES (V22.6-FINAL): $1000 account | $50 MARGIN entry | 10x | -$20 stop | unlimited count.
# entry_mode=margin (default): PHOENIX_ENTRY_MARGIN_USD x PHOENIX_LEVERAGE = notional (50 x 10 = 500 USD).
# The -$20 stop is then a ~4% price move - INSIDE the ~10% isolated-liquidation distance, so the
# stop is REAL and reachable (this fixes the V22.0.5 contradiction where $50 notional put the stop
# at ~40%, far beyond liquidation).
# entry_mode=notional: PHOENIX_ENTRY_NOTIONAL_USD is used directly (e.g. 50). The stop distance is
# then capped to liquidation_buffer_fraction/leverage (7% at 10x) so it always fires before liquidation.
PHOENIX_REFERENCE_EQUITY=1000
PHOENIX_ENTRY_MODE=margin
PHOENIX_ENTRY_MARGIN_USD=50
# PHOENIX_ENTRY_NOTIONAL_USD=50            # only with PHOENIX_ENTRY_MODE=notional
PHOENIX_LEVERAGE=10
PHOENIX_MAX_LOSS_USD=20
PHOENIX_LIQUIDATION_BUFFER_FRACTION=0.70
PHOENIX_RISK_PER_TRADE_USD=20
# Portfolio kill-switches OFF (user rule: no daily/weekly loss stop). 0 = off; drawdown 1.0 = off.
PHOENIX_DAILY_LOSS_LIMIT_USD=0
PHOENIX_WEEKLY_LOSS_LIMIT_USD=0
PHOENIX_MAX_DRAWDOWN_PCT=1.0
PHOENIX_MAX_OPEN_POSITIONS=0
PHOENIX_MAX_RESERVED_MARGIN_PCT=1.0

# ---------------- COST MODEL ----------------
PHOENIX_FEE_BPS_PER_SIDE=5.5
PHOENIX_SLIPPAGE_BPS_RESERVE=3

# ---------------- ENTRY / EXIT (V22.6 exit engine) ----------------
# PROBLEM FIXED: V22.5 cut winners at +$0.10 while losers ran to the stop (payoff ~1:40).
# Now: tp_min_r=0.5 -> the indicator exit may only fire once net >= 0.5 x risk ($10 at -$20 risk).
# breakeven_r=0.5     -> once net >= $10 the stop moves to entry+costs (position can no longer lose).
# trail_arm_r=1.0     -> once peak net >= $20 the stop trails at peak - trail_giveback_r x risk.
# The stop only ever TIGHTENS; the fixed -$20 floor never widens. tp_mode=fixed_rr = old fixed target.
PHOENIX_TP_MODE=indicator
PHOENIX_TP_EXIT_SCORE=0.10
PHOENIX_TP_MIN_NET_USD=0.0
PHOENIX_TP_MIN_R=0.5
PHOENIX_BREAKEVEN_R=0.5
PHOENIX_TRAIL_ARM_R=1.0
PHOENIX_TRAIL_GIVEBACK_R=0.5
PHOENIX_LIVE_INDICATOR_TP=1
# time budget per cycle for scoring open positions (indicator exits)
PHOENIX_EXIT_EVAL_BUDGET_SEC=40
PHOENIX_TP_R=2.2
# --- V22.6 signal-quality upgrades ---
PHOENIX_OI_PRICE_AGREEMENT=1
# PHOENIX_OI_PRICE_AGREEMENT: sign OI flow with 15m price direction
PHOENIX_CONFLICT_PENALTY=0.70
# PHOENIX_CONFLICT_PENALTY: score x 0.70 when 15m trend and 1h/4h disagree (1 = off)
PHOENIX_RSI_GATE=1
# PHOENIX_RSI_GATE: block entries into overextended moves
PHOENIX_RSI_BLOCK_HIGH=78
# PHOENIX_RSI_BLOCK_HIGH: no LONG when 15m RSI(14) >= 78
PHOENIX_RSI_BLOCK_LOW=22
# PHOENIX_RSI_BLOCK_LOW: no SHORT when 15m RSI(14) <= 22
PHOENIX_PAPER_FUNDING_ACCRUAL=1
# PHOENIX_PAPER_FUNDING_ACCRUAL: accrue funding every 8h held in PAPER
PHOENIX_MAX_HOLD_BARS=96
PHOENIX_MAKER_TIMEOUT_SEC=45
# minimum price move (bps) that justifies cancel+replace; below it the resting order keeps its queue place
PHOENIX_REQUOTE_BPS=1
PHOENIX_MAX_REQUOTES=2
# never chase the market further than this from the original signal price
PHOENIX_MAX_CHASE_BPS=10
# if the exchange minimum notional is above target: bump up to this factor, else skip (0 = never bump)
PHOENIX_AUTO_BUMP_MAX_FACTOR=1.0
# position mode: OKX net|long_short ; Binance oneway|hedge ; OKX margin mode cross|isolated
PHOENIX_OKX_POS_MODE=net
PHOENIX_BINANCE_POS_MODE=oneway
PHOENIX_OKX_TD_MODE=cross

# ---------------- SIGNAL FILTERS ----------------
# score = weighted AVERAGE of components in [-1,1]. 0.72 was unreachable (max measured 0.66).
PHOENIX_MIN_SCORE=0.30
PHOENIX_MAX_SPREAD_BPS=12
PHOENIX_MIN_QUOTE_VOLUME_USD=1000000
PHOENIX_STALE_BOOK_SEC=3
PHOENIX_FUNDING_SCALE=0.0005
PHOENIX_OI_CHANGE_SCALE=100
PHOENIX_OI_LOOKBACK_SEC=300
# trend and higher-timeframe must agree in sign and each exceed ALIGNMENT_MIN.
# Always counted in the report (passed_min_score_and_aligned); only enforced when REQUIRE_ALIGNMENT=1.
PHOENIX_REQUIRE_ALIGNMENT=0
PHOENIX_ALIGNMENT_MIN=0.10

# ---------------- PORTFOLIO / CORRELATION ----------------
PHOENIX_CORRELATION_WINDOW=96
PHOENIX_CORRELATION_LIMIT=0.85
# the gate is skipped (and counted) below this many return samples; only same-direction exposure is blocked
PHOENIX_CORRELATION_MIN_SAMPLES=30
PHOENIX_CORRELATION_SAME_DIRECTION_ONLY=1
# 0 = ATR never changes the stop (stop is the fixed -MAX_LOSS_USD rule). >0 lets ATR only tighten it.
PHOENIX_ATR_STOP_MULTIPLIER=0
# paper STOP fill: stop = at stop price (gap reported separately); worse = worse of stop and last mark (conservative)
PHOENIX_PAPER_STOP_FILL=worse

# ---------------- STRATEGY WEIGHTS ----------------
PHOENIX_WEIGHT_TREND=0.35
PHOENIX_WEIGHT_HTF=0.20
PHOENIX_WEIGHT_OI=0.15
PHOENIX_WEIGHT_BOOK=0.15
PHOENIX_WEIGHT_FUNDING=0.05
PHOENIX_WEIGHT_LIQUIDATION=0.10

# ---------------- STATE / JOURNAL ----------------
PHOENIX_STATE_PATH=state.json
PHOENIX_JOURNAL_PATH=trades.jsonl
PHOENIX_PAPER_STATE_PATH=paper_state.json
PHOENIX_PAPER_JOURNAL_PATH=paper_trades.jsonl

# ---------------- LIVE DATA LOOP ----------------
PHOENIX_LIVE_DURATION_SEC=300
PHOENIX_LIVE_POLL_SEC=15
# symbols detailed per exchange per cycle (volume ranked). 0 = ALL eligible (Binance WAF-ban risk).
PHOENIX_LIVE_DETAIL_PER_CYCLE=100
# extra symbols per exchange per cycle taken round-robin from the tail so the long tail is covered over time
PHOENIX_ROTATION_SLOTS=25
# 0 = unlimited. Set e.g. 240 so one cycle can never run past its budget.
PHOENIX_MAX_CYCLE_SEC=180
PHOENIX_MAX_CYCLES=0
PHOENIX_INCLUDE_DATED_FUTURES=1
# 1h/4h candles and funding change slowly: cache them (fewer REST calls = fewer bans)
PHOENIX_HTF_CACHE_SEC=600
PHOENIX_FUNDING_CACHE_SEC=300
PHOENIX_EXCHANGE_TIMEOUT_MS=10000
PHOENIX_ORDERBOOK_LIMIT=20
PHOENIX_LIQUIDATION_LIMIT=50
PHOENIX_MAX_MARKET_AGE_SEC=20
PHOENIX_RECONCILE_SEC=15
PHOENIX_LIVE_REPORT_PATH=live_test_report.json
# optional: one JSON line per scored snapshot
PHOENIX_SCORE_LOG=
PHOENIX_CHECKPOINT_EVERY=25
