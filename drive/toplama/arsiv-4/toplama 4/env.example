# ============ KriptoBot Yapılandırması ============

# --- Telegram (zorunlu) ---
# @BotFather'dan aldığın token buraya:
# (Telegram sürümü kaldırıldı — masaüstü panel)
# Senin Telegram kullanıcı ID'n (admin için; @userinfobot öğrenebilir)

# --- EVREN LLM (SAYZEK) — OpenAI uyumlu, tek anahtarla çok model ---
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1

# --- Diğer sağlayıcılar (opsiyonel — eklersen otomatik aktifleşir) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Ollama (senin bilgisayarında yerel model) ---
OLLAMA_MODEL=llama3.2

# --- Özel endpoint (herhangi bir OpenAI-uyumlu adres) ---
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# --- Tarama / alarm ayarları ---
SCAN_INTERVAL_MIN=15
STRONG_ALERT_SCORE=45
ALERT_COOLDOWN_H=2
