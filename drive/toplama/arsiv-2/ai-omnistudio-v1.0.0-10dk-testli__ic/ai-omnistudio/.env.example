# AI OmniStudio — 20 YZ sağlayıcı anahtarları
# Hepsini doldurmak ZORUNLU DEĞİL. Anahtarı olan sağlayıcı canlı çağrılır,
# olmayanı çağrılmaz ve konsey kural tabanlı kantitatif denetime düşer.
# Bu dosyayı .env olarak kopyalayın. .env git'e GÖNDERİLMEZ.

# --- Tek anahtarla çok model (en pratik) ---
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_MODEL=deepseek/deepseek-chat

# --- Tier 1: hakemler ---
OPENAI_API_KEY=
OPENAI_API_KEY_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_API_KEY_MODEL=gemini-2.5-pro

# --- Tier 2: denetçiler ---
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
COHERE_API_KEY=
HYPERBOLIC_API_KEY=
DEEPINFRA_API_KEY=
NOVITA_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=

# --- Tier 3: hızlı ön eleme ---
GROQ_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
