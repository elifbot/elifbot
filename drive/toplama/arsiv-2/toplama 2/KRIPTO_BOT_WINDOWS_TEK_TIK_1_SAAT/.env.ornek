# KRIPTO-BOT v7.8 — ortam değişkenleri ŞABLONU
# Kopyala:  cp .env.ornek .env && chmod 600 .env
# Sırları ASLA config.yaml'a veya git'e yazmayın.

# ---------- ÇALIŞMA MODU: paper | testnet | live ----------
MODE=paper

# Süreli paper oturumu (saat). 0 = süresiz. Yalnız paper'da geçerli.
PAPER_SESSION_HOURS=0

# Binance coğrafi blok (HTTP 451) görürsen 1 bırak.
BINANCE_PUBLIC_WWW=1

# Aynı SQLite dosyasını bot ve panel paylaşır (boşsa config.yaml'daki veritabani.dosya).
# BOT_DB_FILE=/opt/kripto-bot/kripto-bot-v7.8/bot_state.db
# CONFIG_FILE=/opt/kripto-bot/kripto-bot-v7.8/config.yaml

# ---------- WEB PANELİ + HEALTH ----------
DASHBOARD_HOST=0.0.0.0
PORT=8501
# Boş bırakılırsa panel API'leri YALNIZ 127.0.0.1'e açıktır.
# Dışarıdan erişecekseniz en az 16 karakterlik rastgele token girin.
DASHBOARD_TOKEN=

# ---------- BİLDİRİM ----------
# REQUIRE_NOTIFICATIONS=1 iken config.yaml'da etkin bir kanalın kimlik bilgisi
# eksikse veya gerçek açılış test mesajı teslim edilemezse bot işlem açmaz.
REQUIRE_NOTIFICATIONS=1
NOTIFICATION_STARTUP_TEST=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp için aşağıdaki üç yöntemden biri yeterlidir:
# 1) telefon + API anahtarı, 2) telefon + Meta token + phone-number ID,
# 3) webhook URL'si.
WHATSAPP_PHONE=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# ---------- HABER / LLM (opsiyonel) ----------
CRYPTOPANIC_KEY=
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=gpt-4o-mini

# ---------- YALNIZ testnet / live ----------
# Not: config.yaml'da borsalar: ["binance","okx"] ise HER İKİ borsanın
# anahtarları zorunludur. Tek borsayla çalışacaksanız listeyi tek elemana indirin.
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# GERÇEK PARA KİLİDİ — live modda bu satır olmadan bot açılmaz.
# LIVE_TRADING_CONFIRM=YES_I_RISK_REAL_MONEY
