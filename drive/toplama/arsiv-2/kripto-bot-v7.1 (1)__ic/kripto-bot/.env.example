# ===== BORSA API ANAHTARLARI (asla kimseyle paylaşma, dosyayı Git'e koyma!) =====
# MODE: paper (sanal para) | testnet (borsa test ağı) | live (GERÇEK PARA - dikkat!)
MODE=paper

BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Opsiyonel: anlık haberler için ücretsiz CryptoPanic anahtarı (https://cryptopanic.com/developers/api/)
CRYPTOPANIC_KEY=

# Opsiyonel: Telegram bildirimleri (@BotFather'dan bot aç, chat id'yi @userinfobot'tan al)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsiyonel: Haber psikolojisi için LLM API (OpenAI-uyumlu herhangi bir uç).
# Boş bırakılırsa %100 ücretsiz YEREL korku/açgözlülük motoru kullanılır.
# Örnekler: https://api.openai.com/v1 | https://api.groq.com/openai/v1 | http://localhost:11434/v1 (Ollama)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
