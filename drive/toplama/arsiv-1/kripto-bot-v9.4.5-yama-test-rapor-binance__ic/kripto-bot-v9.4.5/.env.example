# Kripto Bot v9.0 — Ortam Değişkenleri Şablonu
# Not: Hiçbir gizli anahtar JSON yapılandırma dosyasına yazılmaz; yalnızca .env üzerinden okunur.

MODE=paper
CONFIG_FILE=configs/v9-canonical-production.json

# İsteğe Bağlı Borsa API Anahtarları (testnet / live modları için)
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# İsteğe Bağlı Canlı LLM Hakemi (OpenAI uyumlu uç nokta)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
